# انسخ هذا الملف إلى .env واملأ بياناتك (كلها مجانية)
PORT=3000
# AliExpress Open Platform — portals.aliexpress.com
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=
# كلمات البحث الافتراضية للسحب التلقائي
ALI_KEYWORDS=wireless earbuds, smart watch, led lamp
ALI_PAGE_SIZE=20
# الايميل المجاني الحقيقي — Brevo: 300 ايميل/يوم مجاناً وبدون بطاقة (brevo.com)
# سجل ثم Settings > SMTP & API وانسخ المفتاح هنا
BREVO_API_KEY=
BREVO_SENDER=
# أو SMTP تقليدي (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# تيليجرام المجاني: اعمل قناة + بوت عبر BotFather والصق هنا (اختياري)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STORE_URL=http://localhost:3000
SYNC_EVERY_HOURS=6
